# Copy to rocket-credit-deployment/diploma/.env (git-ignored) and change every value.
DB_NAME=rocketcredit
DB_ADMIN_USER=rocket_admin
DB_ADMIN_PASSWORD=change-me-admin
DB_APP_USER=rocket_app
DB_APP_PASSWORD=change-me-app
DB_HOST_PORT=5438
BACKEND_HOST_PORT=8080
ANALYSIS_WORKERS=2
# Shared secret the backend sends to the analysis service (X-Analysis-Token).
ANALYSIS_SHARED_SECRET=change-me-analysis
# Fixture mode is deterministic and does not call a model. Set to AI and configure the
# key of AI_PROVIDER below to run a model against repository-owned synthetic evidence only.
ANALYSIS_DEMO_PROVIDER_MODE=FIXTURE
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=30
# AI provider for AI mode: JEV (default; TypeSafe System One — typed yes/no, choice and score
# answers, key from console.typesafe.ai), GEMINI, or ANTHROPIC (Claude Haiku 5.5).
AI_PROVIDER=JEV
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Set true when the demo is served over HTTPS.
COOKIE_SECURE=false
# Feature preparation for applications: SEQUENTIAL or PARALLEL (identical results; see research/benchmarks).
FEATURES_MODE=PARALLEL
