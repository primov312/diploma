<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.rocketcredit</groupId>
  <artifactId>rocket-credit-claimcheck</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <aws.sdk.v2>2.25.49</aws.sdk.v2>
    <jackson.ver>2.17.1</jackson.ver>
  </properties>

  <dependencies>
    <!-- JSON mapping for DTOs (no Spring types here) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.ver}</version>
    </dependency>
    <!-- S3 client for the storage impl -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws.sdk.v2}</version>
    </dependency>
    <!-- Optional: lombok for DTOs -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.32</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>